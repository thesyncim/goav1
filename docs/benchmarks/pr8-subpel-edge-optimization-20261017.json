  "optimization": {
    "behavior": "The scratchless clamped X/Y dispatch can vectorize resident interior subsets, but edge portions fall back to per-tap scalar clamping. The prober-owned scratch-aware path materializes the needed halo once and then runs the existing vector kernel over the block.",
    "semantic_scope": "No motion-search strategy, filter, interpolation result, or output format changes; scalar fallback remains available.",
    "scratch_ownership": "The edge materialization uses p.scratch.edge, distinct from the IM, SAD scratch, and subpel cache.",
    "pinned_dav1d_source_shape": {
      "reference_commit": "b546257f770768b2c88258c533da38b91a06f737",
      "locations": [
        "src/mc_tmpl.c:868",
        "src/recon_tmpl.c:969-977"
      ],
      "comparison": "Source-shape context for emu-edge plus existing motion-compensation kernels, not a measurement of dav1d throughput. The embedded commit reference is not proof that the installed library was built from that checkout.",
      "reviewed_against_commit_note": "The pinned source-code shape is an implementation comparison only; the separate installed dav1d 1.5.3 runtime artifact reports unverified binary provenance."
    },
    "installed_dav1d_measurement_provenance": {
      "runtime_version": "1.5.3",
      "runtime_library": "/opt/homebrew/Cellar/dav1d/1.5.3/lib/libdav1d.7.dylib",
      "runtime_library_sha256": "bdd18b4f70a9e8956a58de310d8acfdad2ecf6b1be00b813b397e14331d5d0bd",
      "binary_provenance_verified": false,
      "separate_artifact": "docs/benchmarks/pr8-dav1d-gap-20261017.json",
      "scope_note": "That artifact measures a public full-clip decoder operation on an exploratory corpus. It is a separate runtime comparison and must not be represented as a pinned-source or subpel benchmark."
    }
  },
  "redundant_work_audit": {
